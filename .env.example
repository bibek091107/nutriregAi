# NutriReg AI frontend — environment configuration
#
# Copy to `.env.local` and adjust as needed.
# NEXT_PUBLIC_* values are exposed to the browser; never place secrets here.

# Base URL of the NutriReg API (FastAPI). No trailing slash required.
#
# With Vercel services this is NOT needed — the Vercel rewrite layer routes
# /api/* to the backend service on the same domain automatically.
#
# Set only for local development without `vercel dev`:
# NEXT_PUBLIC_API_URL=http://localhost:8000
